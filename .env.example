# Copy to .env.local. Never commit actual keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated alternate models. A 429 moves immediately to the next model.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# Optional independent signing secret. Falls back to GEMINI_API_KEY on the server.
# GUARDIAN_SIGNING_KEY=

# Review API abuse protection. Cloud Run automatically uses Firestore; local development uses memory.
# GUARDIAN_RATE_LIMIT_BACKEND=memory
GUARDIAN_REVIEW_WINDOW_SECONDS=600
GUARDIAN_REVIEW_WINDOW_LIMIT=2
GUARDIAN_REVIEW_DAILY_LIMIT=3
# Optional when using a non-default Firestore database.
# GUARDIAN_FIRESTORE_DATABASE=(default)
