# Copy to .env.local. Never commit actual keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Actual alternate model on temporary API failures. Set empty to disable fallback.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Optional independent signing secret. Falls back to GEMINI_API_KEY on the server.
# GUARDIAN_SIGNING_KEY=
