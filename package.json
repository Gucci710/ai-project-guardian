{
  "name": "ai-project-guardian",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test:browser": "playwright test",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:launch": "node scripts/verify-launch.mjs",
    "test": "tsc --module commonjs --moduleResolution node --target ES2022 --esModuleInterop --skipLibCheck --outDir .test-build tests/guardian.test.ts tests/launch.test.ts && node --test .test-build/tests/guardian.test.js .test-build/tests/launch.test.js"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
